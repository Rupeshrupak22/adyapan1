# ─── Database (TiDB Cloud / MySQL) ───────────────────────────────────
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/preschool?sslaccept=strict"

# Raw MySQL (for leaves, meetings routes)
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=username
MYSQL_PASSWORD=password
MYSQL_DATABASE=preschool
MYSQL_SSL=true

# ─── JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=your-strong-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Server ─────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS (comma-separated origins for production) ───────────────────
# Leave empty for dev (allows all). Set for production:
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-domain.com
CORS_ORIGINS=
